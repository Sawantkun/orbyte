# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Tests use the same URL with the database name
# suffixed "_test" unless TEST_DATABASE_URL is set.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/orbyte"
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/orbyte_test"

# Redis (BullMQ execution queue — used from Milestone 3).
REDIS_URL="redis://localhost:6379"

# Public URL of this app.
APPLICATION_URL="http://localhost:3000"

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── Secrets encryption ──────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts user-supplied provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   — never change it without a key rotation.
ENCRYPTION_KEY=""

# ─── AI providers ────────────────────────────────────────────────────────────
# Optional platform-level OpenAI key (Milestone 3). Users can also add their own keys.
OPENAI_API_KEY=""

# ─── Object storage ──────────────────────────────────────────────────────────
# "local" writes to STORAGE_LOCAL_DIR (development only). "s3" works with any
# S3-compatible service (AWS S3, Cloudflare R2, MinIO…).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./.storage"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Custom endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""

# Maximum upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES="52428800"
