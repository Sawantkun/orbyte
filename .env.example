# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Tests use the same URL with the database name
# suffixed "_test" unless TEST_DATABASE_URL is set.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/orbyte"
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/orbyte_test"

# Redis (BullMQ execution queue — used from Milestone 3).
REDIS_URL="redis://localhost:6379"

# Public URL of this app.
APPLICATION_URL="http://localhost:3000"

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── Secrets encryption ──────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts user-supplied provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   — never change it without a key rotation.
ENCRYPTION_KEY=""

# ─── AI providers ────────────────────────────────────────────────────────────
# Optional platform-level OpenAI key (Milestone 3). Users can also add their own keys.
OPENAI_API_KEY=""

# ─── Object storage ──────────────────────────────────────────────────────────
# "local" writes to STORAGE_LOCAL_DIR (development only). "s3" works with any
# S3-compatible service (AWS S3, Cloudflare R2, MinIO…).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./.storage"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Custom endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""

# Maximum upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES="52428800"

# Auth endpoint rate limiting ("on" | "off"). Keep "on" outside automated test servers.
AUTH_RATE_LIMIT="on"

# ─── Execution engine (worker) ───────────────────────────────────────────────
# Override for OpenAI-compatible gateways or local mocks.
OPENAI_BASE_URL="https://api.openai.com"
# Executions processed in parallel per worker process.
WORKER_CONCURRENCY="4"
# Nodes run in parallel within one execution.
EXECUTION_NODE_CONCURRENCY="4"
# Per-node timeout and attempts for retryable failures (rate limits, 5xx, timeouts).
EXECUTION_NODE_TIMEOUT_MS="120000"
EXECUTION_MAX_ATTEMPTS="3"
EXECUTION_QUEUE_NAME="workflow-executions"
# Optional: serve GET /health from the worker on this port.
# WORKER_HEALTH_PORT="3101"

# ─── Secret key rotation ─────────────────────────────────────────────────────
# To rotate: move the current key to ENCRYPTION_KEY_PREVIOUS, set a new
# ENCRYPTION_KEY, bump ENCRYPTION_KEY_VERSION, run `pnpm secrets:rotate`,
# then remove ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY_VERSION="1"
ENCRYPTION_KEY_PREVIOUS=""

# ─── Proxy / client IP (auth rate limiting) ──────────────────────────────────
# Headers your proxy sets with the real client IP, e.g. "cf-connecting-ip".
AUTH_IP_HEADERS=""
# Proxies allowed to append to X-Forwarded-For, e.g. "10.0.0.0/24".
TRUSTED_PROXIES=""

# ─── Personal use: local Claude CLI ──────────────────────────────────────────
# AI Text nodes can run through the Claude Code CLI signed in on THIS machine.
# Switch it on in Integrations → Add service → Claude (local CLI); only the
# account that switches it on can use it. "off" hard-disables it (do this on any
# deployment other people use). Set CLAUDE_CLI_PATH if `claude` isn't on PATH.
LOCAL_CLAUDE_CLI="allow"
# CLAUDE_CLI_PATH="/Users/you/.local/bin/claude"

# ─── Account email (verification, password reset) ───────────────────────────
# Gmail account Orbyte sends from, with a Google app password. Unset in
# development: emails (with their links) are printed to the server console.
# SYSTEM_MAIL_USER="orbyte.noreply@gmail.com"
# SYSTEM_MAIL_PASSWORD="abcdefghijklmnop"
# "on": new accounts must verify their email before they can sign in.
REQUIRE_EMAIL_VERIFICATION="off"

# ─── Semantic asset search ───────────────────────────────────────────────────
# "auto": uses the user's OpenAI key (or OPENAI_API_KEY) to embed assets; the
# worker indexes new and edited assets. Index existing ones: pnpm assets:reindex
SEMANTIC_SEARCH="auto"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
