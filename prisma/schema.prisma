// Orbyte data model. See docs/ARCHITECTURE.md §Database for rationale.
//
// Conventions:
// - IDs are cuid strings generated by Prisma (Better Auth tables included).
// - Every user-owned row carries `ownerId` and is indexed by it. Ownership is
//   enforced in the service layer (src/server/**), never only in the UI.
// - Deleting a user cascades to everything they own.
// - Deleting a workflow keeps its generated assets (FKs set to NULL).
// - Deleting a collection keeps its assets (collectionId set to NULL).
// - Binary file content is never stored here, only storage keys.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication (shape required by Better Auth)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  workflows       Workflow[]
  workflowVers    WorkflowVersion[]
  executions      WorkflowExecution[]
  assets          Asset[]
  collections     AssetCollection[]
  tags            AssetTag[]
  integrations    Integration[]
  usageRecords    UsageRecord[]
  activityLogs    ActivityLog[]
  promptTemplates PromptTemplate[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflows
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The editable workflow. `definition` is the current draft graph; each save
/// that the user publishes snapshots it into an immutable WorkflowVersion.
model Workflow {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  /// Draft graph: { nodes, edges, inputSchema, schemaVersion }. Validated with Zod.
  definition    Json
  latestVersion Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions   WorkflowVersion[]
  executions WorkflowExecution[]
  assets     Asset[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, status])
  @@map("workflow")
}

/// Immutable snapshot. Executions always run against a version, never the draft.
model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  definition  Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@map("workflow_version")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionTrigger {
  MANUAL
  RETRY
  API
}

model WorkflowExecution {
  id                String              @id @default(cuid())
  ownerId           String
  owner             User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workflowId        String
  workflow          Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersionId String
  workflowVersion   WorkflowVersion     @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  status            ExecutionStatus     @default(PENDING)
  trigger           ExecutionTrigger    @default(MANUAL)
  /// Client-supplied key to prevent duplicate submissions.
  idempotencyKey    String?
  retryOfId         String?
  retryOf           WorkflowExecution?  @relation("ExecutionRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           WorkflowExecution[] @relation("ExecutionRetry")
  input             Json?
  output            Json?
  /// Sanitised error: { code, message }. Never raw provider payloads.
  error             Json?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  inputTokens       Int                 @default(0)
  outputTokens      Int                 @default(0)
  estimatedCostUsd  Decimal             @default(0) @db.Decimal(14, 6)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  nodeExecutions NodeExecution[]
  assets         Asset[]
  usageRecords   UsageRecord[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, status])
  @@index([workflowId, createdAt(sort: Desc)])
  @@map("workflow_execution")
}

enum NodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model NodeExecution {
  id           String              @id @default(cuid())
  executionId  String
  execution    WorkflowExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  /// Node id inside the workflow graph (not a DB id).
  nodeId       String
  nodeType     String
  status       NodeExecutionStatus @default(PENDING)
  attempt      Int                 @default(1)
  input        Json?
  output       Json?
  error        Json?
  /// Structured log lines: [{ ts, level, message, data? }]. Secrets redacted.
  logs         Json?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  inputTokens  Int                 @default(0)
  outputTokens Int                 @default(0)
  costUsd      Decimal             @default(0) @db.Decimal(14, 6)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  usageRecords UsageRecord[]

  @@unique([executionId, nodeId, attempt])
  @@index([executionId])
  @@map("node_execution")
}

/// A reusable prompt with {{variables}}. Prompt Template nodes copy its content
/// into their config, so editing a library template never changes a published version.
model PromptTemplate {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  content     String
  /// Variable names extracted from content, for display and search.
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("prompt_template")
}

// ─────────────────────────────────────────────────────────────────────────────
// Assets
// ─────────────────────────────────────────────────────────────────────────────

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  TEXT
  JSON
  CODE
  OTHER
}

enum AssetSource {
  UPLOAD
  WORKFLOW
}

model Asset {
  id             String             @id @default(cuid())
  ownerId        String
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  kind           AssetKind
  source         AssetSource        @default(UPLOAD)
  mimeType       String
  extension      String?
  /// Bytes. Upload limits keep this well inside Int range (see env MAX_UPLOAD_BYTES).
  sizeBytes      Int
  /// Opaque object-storage key. Never sent to the client.
  storageKey     String             @unique
  thumbnailKey   String?
  isFavorite     Boolean            @default(false)
  collectionId   String?
  collection     AssetCollection?   @relation("CollectionAssets", fields: [collectionId], references: [id], onDelete: SetNull)
  originalPrompt String?
  aiProvider     String?
  aiModel        String?
  workflowId     String?
  workflow       Workflow?          @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  executionId    String?
  execution      WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  nodeId         String?
  /// Free-form technical metadata (dimensions, duration, etc.).
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tags    AssetTagRelation[]
  coverOf AssetCollection[]  @relation("CollectionCover")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, kind])
  @@index([ownerId, collectionId])
  @@index([ownerId, isFavorite])
  @@index([workflowId])
  @@index([executionId])
  @@map("asset")
}

model AssetCollection {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  coverAssetId String?
  coverAsset   Asset?   @relation("CollectionCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[] @relation("CollectionAssets")

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("asset_collection")
}

model AssetTag {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Normalised lower-case tag name.
  name      String
  createdAt DateTime @default(now())

  assets AssetTagRelation[]

  @@unique([ownerId, name])
  @@map("asset_tag")
}

model AssetTagRelation {
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId     String
  tag       AssetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([assetId, tagId])
  @@index([tagId])
  @@map("asset_tag_relation")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations & usage
// ─────────────────────────────────────────────────────────────────────────────

enum IntegrationStatus {
  UNVERIFIED
  ACTIVE
  INVALID
}

/// A user-supplied provider credential. The secret is AES-256-GCM encrypted
/// (ciphertext + iv + auth tag) and only decrypted server-side at execution time.
model Integration {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Provider slug from the provider registry, e.g. "openai".
  provider        String
  label           String
  encryptedSecret String
  iv              String
  authTag         String
  /// Which ENCRYPTION_KEY generation encrypted this row (key rotation).
  keyVersion      Int               @default(1)
  /// Last 4 characters only, for display.
  secretHint      String
  status          IntegrationStatus @default(UNVERIFIED)
  lastValidatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([ownerId, provider, label])
  @@index([ownerId])
  @@map("integration")
}

model UsageRecord {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider        String
  model           String
  executionId     String?
  execution       WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  nodeExecutionId String?
  nodeExecution   NodeExecution?     @relation(fields: [nodeExecutionId], references: [id], onDelete: SetNull)
  inputTokens     Int                @default(0)
  outputTokens    Int                @default(0)
  imageCount      Int                @default(0)
  /// NULL when no pricing information exists for the model.
  costUsd         Decimal?           @db.Decimal(14, 6)
  createdAt       DateTime           @default(now())

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([executionId])
  @@map("usage_record")
}

model ActivityLog {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Dotted action name, e.g. "workflow.created", "asset.uploaded".
  action     String
  entityType String
  entityId   String?
  /// Small, non-sensitive context for rendering the feed.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("activity_log")
}
